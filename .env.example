# Copy to .env and fill in. .env is gitignored.
APP_ENV=development

# Supabase Postgres session-pooler connection string (from Project Settings to Database)
DATABASE_URL=

# Supabase project ref (from Project Settings to General)
SUPABASE_PROJECT_REF=

# Origins allowed to call the API from a browser, comma separated.
# Local development can leave this unset (defaults to a wildcard). In production set it to the
# deployed frontend, e.g. https://before.vercel.app
# ALLOWED_ORIGINS=
