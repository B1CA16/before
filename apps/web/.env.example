NEXT_PUBLIC_API_URL=http://127.0.0.1:8000

# Supabase, for auth only. Both values are safe in the browser: the publishable key grants only
# what row level security allows. Never put the service-role or sb_secret_ key in this app.
# Find them in the Supabase dashboard under Settings, API keys.
NEXT_PUBLIC_SUPABASE_URL=https://<project-ref>.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_<...>

# Set to 1 to also offer email sign-in with a 6-digit code. Off by default because it needs working
# SMTP, which needs a sender domain this project does not have yet. Google sign-in needs no email.
# NEXT_PUBLIC_EMAIL_SIGNIN=1

# The site's own absolute origin, used for canonical URLs, hreflang and Open Graph images. All three
# are ignored by crawlers when relative, so this is not optional in production. On Vercel it is
# inferred from VERCEL_PROJECT_PRODUCTION_URL if unset; set it explicitly once there is a real domain.
# NEXT_PUBLIC_SITE_URL=https://before-steel.vercel.app

# Google Search Console ownership token. Only needed if you want Search Console, and only the meta-tag
# method works here: a *.vercel.app subdomain cannot be verified by DNS, since that needs control of
# vercel.app itself. Google shows the token when you add a URL-prefix property. Absent means no tag.
# NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=
