NEXT_PUBLIC_API_URL=http://127.0.0.1:8000

# Supabase, for auth only. Both values are safe in the browser: the publishable key grants only
# what row level security allows. Never put the service-role or sb_secret_ key in this app.
# Find them in the Supabase dashboard under Settings, API keys.
NEXT_PUBLIC_SUPABASE_URL=https://<project-ref>.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_<...>

# Set to 1 to also offer email sign-in with a 6-digit code. Off by default because it needs working
# SMTP, which needs a sender domain this project does not have yet. Google sign-in needs no email.
# NEXT_PUBLIC_EMAIL_SIGNIN=1
